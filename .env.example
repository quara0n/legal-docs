# --- Site -------------------------------------------------------------------
# Which market this deployment sells to: "no" (Norway, Norwegian templates and
# site, prices in NOK; the default) or "us" (US templates, English, USD).
NEXT_PUBLIC_MARKET=no
# Public URL of the site (no trailing slash). Used for sitemap, canonical URLs,
# social images and Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Brand name shown everywhere.
NEXT_PUBLIC_SITE_NAME=Rettfram
# Where customers write for help and refunds.
NEXT_PUBLIC_SUPPORT_EMAIL=hei@rettfram.no
# The legal entity selling the documents, shown in the terms and privacy policy.
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_ADDRESS=
# Organisasjonsnummer (Norway), shown in the terms, privacy policy and footer.
NEXT_PUBLIC_COMPANY_ID=

# --- Payments ---------------------------------------------------------------
# Stripe secret key. sk_test_... while testing, sk_live_... in production.
# Leave empty to run in demo mode: "Pay" skips straight to the download.
STRIPE_SECRET_KEY=
# Set to 1 once Stripe has given your account access to Vipps (private preview).
NEXT_PUBLIC_VIPPS=

# --- Analytics (optional) ---------------------------------------------------
# Cookie-free Plausible analytics. Set to your domain, e.g. rettfram.no.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
